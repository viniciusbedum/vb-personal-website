# Optional. Absolute base URL of the site (canonicals, hreflang, Open Graph,
# JSON-LD, robots, sitemap). Falls back to the Vercel production URL, then
# http://localhost:3000. After adding a custom domain, set it to
# https://yourdomain.com and redeploy (it is applied at build time).
NEXT_PUBLIC_SITE_URL=

# Optional visit counter. Set automatically when you connect "Upstash for
# Redis" to the project in the Vercel Marketplace (the KV_REST_API_* names
# work too). Leave empty to keep the counter off.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
